{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "metals": {
      "type": "remote",
      "url": "http://127.0.0.1:33215/mcp",
      "enabled": true,
    },
    "firefox-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@mozilla/firefox-devtools-mcp@latest",
        "--headless",
        "--viewport",
        "1920x1080",
        "--start-url",
        "http://localhost:8080"
      ],
      "enabled": true,
    },
  },
}